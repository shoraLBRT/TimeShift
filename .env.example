# Скопируйте в .env (он в .gitignore) и заполните. Реальные секреты в репозиторий не кладите.

# --- База данных (compose поднимает postgres) ---
# Имя базы
POSTGRES_DB=timeshift
# Пользователь базы
POSTGRES_USER=timeshift
# Пароль базы: обязательно смените на длинный случайный
POSTGRES_PASSWORD=change-me

# --- Web-клиент и HTTPS (профиль web) ---
# Домен, на который указывает A-запись сервера (для сертификата Let's Encrypt), например time.example.ru
DOMAIN=time.example.ru
# Ключ доступа к web-клиенту, вводится один раз на устройстве; пустой — web-клиент выключен. Длинная случайная строка
WEB_ACCESS_KEY=
# Чей аккаунт открывает web-клиент (chat id в Telegram); пусто — единственный пользователь в базе или отдельный без Telegram
WEB_TELEGRAM_CHAT_ID=
# Контакт для push-сервисов (VAPID), mailto:ваша@почта или https-адрес; пусто — mailto:owner@localhost
PUSH_SUBJECT=

# --- Telegram ---
# Токен бота от @BotFather; пусто — Telegram выключен
TELEGRAM_BOT_TOKEN=
# Прокси до api.telegram.org, если он недоступен напрямую (socks5://host:1080, http://host:3128); пусто — напрямую
TELEGRAM_PROXY=

# --- LLM (OpenAI-совместимый API; без ключа бот работает кнопками и коротким текстом) ---
# Адрес API: агрегатор (ProxyAPI, AITunnel, Polza) или провайдер напрямую
LLM_BASE_URL=https://api.openai.com/v1
# Ключ API; пусто — LLM выключен
LLM_API_KEY=
# Модель, например deepseek-chat, qwen-flash, gpt-4o-mini
LLM_MODEL=gpt-4o-mini
